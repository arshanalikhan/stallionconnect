{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stallionconnect",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      // Self-reference binding; the service name must match the worker name.
      // https://opennext.js.org/cloudflare/caching
      "binding": "WORKER_SELF_REFERENCE",
      "service": "stallionconnect",
    },
  ],
  // Phase 3: a D1 database binding ("DB") is added here for enquiries,
  // job applications and the admin panel.
}
