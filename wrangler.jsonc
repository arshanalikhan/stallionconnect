{
  // Cloudflare Workers config. Built by OpenNext: `npx opennextjs-cloudflare build`.
  // The name must match the Worker/project name in the Cloudflare dashboard.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stallionconnect",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      // Self-reference binding; the service name must match "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "stallionconnect",
    },
  ],
  "observability": { "enabled": true },
  // Database for enquiries and job applications (forms, chatbot, admin panel).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stallionconnect",
      "database_id": "58bc1a20-34d0-4110-89e0-3a92d0a41c17",
      "migrations_dir": "migrations",
    },
  ],
}
